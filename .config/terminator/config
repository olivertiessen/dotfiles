[global_config]
  title_hide_sizetext = True
  suppress_multiple_term_dialog = True
[keybindings]
[profiles]
  [[default]]
    background_color = "#0d1117"
    background_darkness = 1.0
    cursor_color = "#58a6ff"
    font = JetBrainsMono Nerd Font Mono 12
    foreground_color = "#e6edf3"
    show_titlebar = False
    scrollbar_position = hidden
    palette = "#484f58:#ff7b72:#3fb950:#d29922:#58a6ff:#bc8cff:#39c5cf:#b1bac4:#6e7681:#ffa198:#56d364:#e3b341:#79c0ff:#d2a8ff:#56d4dd:#f0f6fc"
    use_system_font = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
